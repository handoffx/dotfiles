{{- /* Rendered by `chezmoi init` into ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $light := promptBoolOnce . "light" "Light-use machine (enable only a few languages)" false -}}
{{- $devDir := promptStringOnce . "lazyxDevDir" "Parent dir of a local lazyx-nvim checkout (empty: install from GitHub)" "" -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o022

[data]
  light = {{ $light }}
  lazyxDevDir = {{ $devDir | quote }}
