-- lazyx-nvim options, see lua/lazyx/config.lua in lazyx-nvim
vim.g.lazyx = {
  light = {{ .light }},
}

require("lazy").setup({
  {
    "AstroNvim/AstroNvim",
    version = "^6",
    import = "astronvim.plugins",
    opts = {
      mapleader = " ",
      maplocalleader = ",",
      icons_enabled = true,
      update_notifications = true,
    },
  },
  {
    "handoffx/lazyx-nvim",
{{- if .lazyxDevDir }}
    dev = true,
{{- end }}
    import = "lazyx.community",
  },
  { import = "lazyx.plugins" },
  { import = "plugins" }, -- machine-local overrides
} --[[@as LazySpec]], {
{{- if .lazyxDevDir }}
  dev = { path = {{ .lazyxDevDir | quote }}, fallback = true },
{{- end }}
  install = { colorscheme = { "catppuccin-mocha", "habamax" } },
  ui = { backdrop = 100, border = "rounded" },
  performance = {
    rtp = {
      disabled_plugins = { "gzip", "netrwPlugin", "tarPlugin", "tohtml", "zipPlugin" },
    },
  },
} --[[@as LazyConfig]])
